{
  "manifest_version": 3,
  "name": "ChatGPT AI Verification",
  "version": "0.1.0",
  "description": "Verifies ChatGPT responses for potential issues",
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}